# Documentation only. Add these values to your existing parent .env, or export
# them in the server environment. Never place provider keys in VITE_* variables.
FIREWORKS_AI_API_KEY=
TAVILY_API_KEY=
CRUCIBLE_PROVIDER=fireworks
# Final route; source-role qualification is separate from the pending full
# scientific workflow. Paid execution requires explicit authorization.
NEBIUS_API_KEY=
CRUCIBLE_NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
CRUCIBLE_ENABLE_NEBIUS=false
# Optional paths for a larger local volume. Migrate the ENTIRE existing runtime
# to preserve receipts and final-exposure history; do not create a fresh ledger.
# CRUCIBLE_RUNTIME=/Volumes/Research/crucible-runtime
# CRUCIBLE_WHEAT_MANIFEST=/Volumes/Research/wheat-assets/manifest.json
# CRUCIBLE_WHEAT_INITIALIZATION=/Volumes/Research/wheat-assets/initialization.json
# CRUCIBLE_WHEAT_PYTHON=/absolute/path/to/crucible/.venv-wheat/bin/python
# Device selection is explicit; existing defaults stay MPS training / CPU
# inference. Optional Linux CUDA software support remains execution-unqualified.
# Use the separate requirements-wheat-linux-cuda.lock on that target, then
# select cuda:0 (or a specific cuda:N). Unavailable devices fail without fallback.
# CRUCIBLE_WHEAT_DEVICE=mps
# CRUCIBLE_WHEAT_INFERENCE_DEVICE=cpu
