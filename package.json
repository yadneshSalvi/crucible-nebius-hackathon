{
  "name": "crucible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": ".venv/bin/python -m uvicorn api.main:app --host 127.0.0.1 --port 4202",
    "dev:web": "vite --host 127.0.0.1 --port 4201 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "concurrently -k -n api,web \"npm:dev:api\" \"vite preview --host 127.0.0.1 --port 4201 --strictPort\"",
    "test": ".venv/bin/python -m pytest -q",
    "test:e2e": "node web/qa.mjs",
    "test:ui-journey": "node web/qa-journey.mjs",
    "format": "prettier --write web package.json tsconfig.json vite.config.ts scripts/browser.mjs",
    "format:check": "prettier --check web package.json tsconfig.json vite.config.ts scripts/browser.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/ibm-plex-sans": "5.2.7",
    "@fontsource/source-serif-4": "5.2.8",
    "lucide-react": "0.548.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.2.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
